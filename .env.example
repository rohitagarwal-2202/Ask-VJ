# ============================================================
# Ask VJ — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ── Data Warehouse ──
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DB=askvj_warehouse
WAREHOUSE_USER=askvj
WAREHOUSE_PASSWORD=askvj_dev
WAREHOUSE_RO_USER=askvj_readonly
WAREHOUSE_RO_PASSWORD=askvj_ro_dev

# ── Source: Farvision ERP (MS SQL Server) ──
FARVISION_HOST=
FARVISION_PORT=1433
FARVISION_DB=
FARVISION_USER=
FARVISION_PASSWORD=

# ── Source: VJ Sales App (PostgreSQL) ──
VJSALES_HOST=
VJSALES_PORT=5432
VJSALES_DB=
VJSALES_USER=
VJSALES_PASSWORD=

# ── Source: VJOP Referral & Loyalty (MS SQL Server) ──
VJOP_HOST=
VJOP_PORT=1433
VJOP_DB=RefferalAndLoyalty
VJOP_USER=
VJOP_PASSWORD=

# ── Local LLM (Ollama) ──
LLM_REASONING_MODEL=mixtral:8x7b
LLM_REASONING_ENDPOINT=http://localhost:11434
LLM_SQL_MODEL=sqlcoder:15b
LLM_SQL_ENDPOINT=http://localhost:11434
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_EMBEDDING_ENDPOINT=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ── Vector DB ──
VECTOR_DB_BACKEND=chromadb
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=8000
VECTOR_DB_COLLECTION=askvj_schema

# ── ETL Settings ──
ETL_SYNC_INTERVAL_HOURS=2
ETL_BRONZE_RETENTION_DAYS=90
ETL_BATCH_SIZE=5000
ETL_QUERY_TIMEOUT=300
ETL_FUZZY_THRESHOLD=0.6
ETL_AUTO_RESOLVE_CONFIDENCE=0.85

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
